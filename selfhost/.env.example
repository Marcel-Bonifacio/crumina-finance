# Copy to selfhost/.env and fill in. NEVER commit the real .env (it is gitignored).
# To move from your managed host without signing anyone out, reuse the SAME secret
# values from it so existing logins/tokens keep working (otherwise users simply sign in again).
PORT=3000
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://crumina.example.com/api/auth/callback
SESSION_SECRET=long-random-string-(openssl rand -base64 48)
TOKEN_ENC_KEY=32-byte-base64-key-(openssl rand -base64 32)

# --- Optional: IMAP sign-in (use ANY email provider, no Google needed) ---
# Set to 1 to show the "or connect your email" options (Outlook.com, iCloud Mail, other IMAP)
# on the login page. Self-host only; the managed host never enables it. Lets you sign in
# with Gmail / Outlook / iCloud / any IMAP server via an app-specific password. Credentials
# are stored AES-256-GCM encrypted in an HttpOnly cookie (no database). Needs HTTPS (or
# localhost) for the cookie. Custom servers must use port 993 (TLS).
IMAP_ENABLED=
# Set to 1 to allow IMAP hosts on private/loopback addresses (a mail server on your LAN).
# Any non-empty value turns it on.
# IMAP_ALLOW_PRIVATE=1

# --- Optional: client IP for rate limiting ---
# Unset: trust X-Real-IP only from Vercel or a loopback/private proxy (Caddy, nginx).
# 1: always trust it (proxy on a public IP that overwrites X-Real-IP). 0: never.
# TRUST_PROXY=
